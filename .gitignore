# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed: `create-data` writes files that are committed too,
# and they only reproduce if the versions it renders with are pinned.
# See DEVELOPMENT.md.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
